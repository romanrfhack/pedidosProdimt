{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["specs/**/*.ts", "real/**/*.ts", "*-fixture.ts", "machine-workspace/**/*.ts", "collections/**/*.ts"]
}
