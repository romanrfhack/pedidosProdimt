# Copy this file to infra/dev/.env and replace the placeholder password.
# SQL Server requires a strong SA password.
PRODIMT_SQL_SA_PASSWORD=REPLACE_WITH_STRONG_LOCAL_PASSWORD

# Change this if port 1433 is already in use.
PRODIMT_SQL_PORT=1433

# These defaults match the application development configuration.
PRODIMT_SQL_HOST=localhost
PRODIMT_SQL_DATABASE=ProdimtPedidos
