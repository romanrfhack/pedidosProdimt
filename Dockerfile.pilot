FROM node:24-bookworm-slim AS web
WORKDIR /src/web
ENV NG_CLI_ANALYTICS=false
COPY apps/prodimt-pedidos-web/package*.json ./
RUN npm ci
COPY apps/prodimt-pedidos-web/ ./
RUN npm run build -- --configuration production

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS api
WORKDIR /src
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1
COPY src/ ./src/
RUN dotnet publish src/Prodimt.Pedidos.Api/Prodimt.Pedidos.Api.csproj \
    --configuration Release --output /app/publish -p:UseAppHost=false -p:UseSharedCompilation=false \
    && rm -f /app/publish/appsettings.Development.json

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=api /app/publish/ ./
COPY --from=web /src/web/dist/prodimt-pedidos-web/browser/ ./wwwroot/
ENV ASPNETCORE_ENVIRONMENT=Production ASPNETCORE_HTTP_PORTS=8080
USER app
EXPOSE 8080
ENTRYPOINT ["dotnet", "Prodimt.Pedidos.Api.dll"]
