{
  "Persistence": {
    "Provider": "SqlServer"
  },
  "DevelopmentSeed": {
    "Enabled": false,
    "ApplyMigrations": false
  },
  "Authentication": {
    "Jwt": {
      "AccessTokenMinutes": 120
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
